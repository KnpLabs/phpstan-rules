parameters:
	ignoreErrors:
		-
			message: '#^Avoid using new DateTime\(''\+1 day''\) directly\. Prefer using \\Psr\\Clock\\ClockInterface instead\.$#'
			identifier: clock.disallowDateTimeNow
			count: 1
			path: tests/Rules/Psr/fixtures/psr20.php

		-
			message: '#^Avoid using new DateTime\(''now''\) directly\. Prefer using \\Psr\\Clock\\ClockInterface instead\.$#'
